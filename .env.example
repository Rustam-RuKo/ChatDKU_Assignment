# Local OpenAI-compatible model endpoint. Replace these values for a hosted provider.
CHATDKU_LLM_MODEL=Qwen/Qwen3-4B
CHATDKU_LLM_BASE_URL=http://localhost:8000/v1
# CHATDKU_LLM_API_KEY=

# The default works on a CPU and is downloaded and cached on first use.
CHATDKU_EMBEDDING_PROVIDER=local
CHATDKU_LOCAL_EMBEDDING_MODEL=

# Optional Text Embeddings Inference service
# CHATDKU_EMBEDDING_PROVIDER=tei
# CHATDKU_EMBEDDING_BASE_URL=http://localhost:18080
# CHATDKU_TEI_EMBEDDING_MODEL=B=
# CHATDKU_EMBEDDING_API_KEY=

# All generated data remains local by default.
CHATDKU_DATA_DIR=./data
CHATDKU_VECTOR_COLLECTION=chatdku
CHATDKU_CHUNK_SIZE=512
CHATDKU_CHUNK_OVERLAP=64
CHATDKU_RETRIEVAL_TOP_K=8
# Conservative context guard; match CONTEXT_TOKENS to the server's actual limit.
# UTF-8 byte bound is intentionally stricter than exact token counting.
CHATDKU_CONTEXT_TOKENS=16384
CHATDKU_CONTEXT_SAFETY_TOKENS=1024
CHATDKU_EVIDENCE_MAX_BYTES=24000
# Optional local cache exported with scripts/export_ollama_tokenizer.py.
# Missing/mismatched cache falls back to the stricter byte bound.
# For the evaluated local Ollama Qwen setup this counter is practically required:
# byte fallback refused the document questions at a 16384-token context.
# See docs/agent.md for the supported model/runtime and export steps.
# CHATDKU_TOKENIZER_PATH=../private/qwen-counter.json
